{
  "name": "siyuan-custom-checkbox",
  "version": "0.1.0",
  "description": "Configurable task-list statuses and icons for SiYuan.",
  "type": "module",
  "main": ".src/index.js",
  "scripts": {
    "format": "dprint fmt",
    "format:check": "dprint check",
    "lint": "eslint . --fix --cache",
    "dev": "pnpm run dev:app",
    "dev:app": "cross-env NODE_ENV=development VITE_SOURCEMAP=inline vite build --watch",
    "build": "pnpm run build:app",
    "test": "pnpm run build:app && node --test tests/custom-task-style.test.mjs",
    "build:app": "cross-env NODE_ENV=production vite build",
    "make-link": "node --no-warnings ./scripts/make_dev_link.js",
    "make-install": "pnpm run build && node --no-warnings ./scripts/make_install.js"
  },
  "keywords": [],
  "author": "Ilham Agustiawan",
  "license": "MIT",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@tsconfig/svelte": "^4.0.1",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "cross-env": "^7.0.3",
    "dprint": "latest",
    "eslint": "^10.8.1",
    "fast-glob": "^3.3.3",
    "glob": "^10.5.0",
    "globals": "^17.11.0",
    "js-yaml": "^4.3.1",
    "minimist": "^1.2.8",
    "npm-run-all": "^4.1.5",
    "rollup-plugin-livereload": "^2.0.5",
    "sass": "^1.102.0",
    "siyuan": "1.2.4",
    "svelte": "^4.2.20",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^5.4.21",
    "vite-plugin-static-copy": "^1.0.6",
    "vite-plugin-zip-pack": "^1.2.4"
  }
}
