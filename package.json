{
  "name": "siyuan-custom-checkbox",
  "version": "0.1.0",
  "description": "Configurable task-list statuses and icons for SiYuan.",
  "main": ".src/index.js",
  "scripts": {
    "format": "dprint fmt",
    "format:check": "dprint check",
    "test": "vitest run",
    "lint": "eslint . --fix --cache",
    "dev": "run-p dev:kernel dev:app",
    "dev:app": "webpack --config webpack.config.js --mode development",
    "dev:kernel": "webpack --config webpack.kernel.config.js --mode development",
    "build": "run-s build:kernel build:app",
    "build:app": "webpack --config webpack.config.js --mode production",
    "build:kernel": "webpack --config webpack.kernel.config.js --mode production"
  },
  "keywords": [],
  "author": "Ilham Agustiawan",
  "license": "MIT",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "dprint": "latest",
    "esbuild-loader": "^4.5.0",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "mini-css-extract-plugin": "^2.10.2",
    "npm-run-all": "^4.1.5",
    "sass": "^1.102.0",
    "sass-loader": "^17.0.0",
    "siyuan": "1.2.4",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "zip-webpack-plugin": "^4.0.3"
  }
}
